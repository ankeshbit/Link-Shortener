# Local PostgreSQL connection URL (backend-only; never expose to the frontend).
# This matches the PostgreSQL service in docker-compose.yml.
DATABASE_URL=postgresql://bytelink:bytelink@localhost:5432/bytelink

# URL embedded in generated short links.
# Local: http://localhost:8000
# LAN: replace localhost with this computer's IPv4 address.
# Tunnel: use the generated https://... tunnel URL.
PUBLIC_BASE_URL=http://localhost:8000

# Firebase Admin SDK credentials (backend-only; never commit real values).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"

# Alternatives to individual Firebase credentials:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_CREDENTIALS_PATH=C:\path\to\firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json

# Exact browser origins, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENV=development
REDIS_URL=redis://localhost:6379/0

# JWT secret key: Required and MUST be at least 32 characters long.
# The backend fails fast at startup if JWT_SECRET is unset or shorter than 32 characters.
JWT_SECRET=bytelink-super-secret-development-jwt-key-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security Flags:
# Enable legacy username/password auth endpoints (/api/auth/register, /api/auth/login, /api/auth/refresh). Defaults to false.
ENABLE_LEGACY_AUTH=false

# Number of reverse proxies in front of FastAPI (default 0). Set to 1 if behind Nginx/Caddy/Cloudflare.
TRUSTED_PROXY_COUNT=0
