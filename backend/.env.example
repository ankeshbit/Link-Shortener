# Neon PostgreSQL connection URL (backend-only; never expose to the frontend)
DATABASE_URL=postgresql://USER:PASSWORD@EP-example-pooler.us-east-2.aws.neon.tech/DATABASE?sslmode=require

# Canonical public URL encoded in generated short links and QR codes.
# Use the deployed HTTPS backend URL in production: https://link-shortener-backend-2n6a.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# Firebase Admin SDK Configuration (Production Render Environment Variable)
# Recommended for Render: Paste the entire content of the downloaded service-account JSON into FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Alternative: Path to credentials file (e.g. Render Secret File /etc/secrets/firebase-service-account.json)
# FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase-service-account.json

# Firebase Project ID (for Application Default Credentials)
FIREBASE_PROJECT_ID=your-project-id

# Comma-separated browser origins allowed to call the backend.
# In production, set this to your deployed Vercel frontend URL(s).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENV=development

# Redis URL for caching and rate-limit coordination.
# REDIS_URL=redis://localhost:6379/0
