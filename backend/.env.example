# Neon PostgreSQL connection URL (backend-only; never expose to the frontend)
DATABASE_URL=postgresql://USER:PASSWORD@EP-example-pooler.us-east-2.aws.neon.tech/DATABASE?sslmode=require

# Canonical public URL encoded in generated short links and QR codes.
# Use the deployed HTTPS backend URL in production: https://link-shortener-backend-2n6a.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# ==============================================================================
# Firebase Admin SDK Configuration (Production Render Environment Variables)
# ==============================================================================
# Method 1 (Recommended for Render): Set individual environment variables
# Note: Keep the quotes around FIREBASE_PRIVATE_KEY so literal \n are preserved.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Method 2 (Alternative): Full service-account JSON in one variable
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id",...}

# Method 3 (Alternative): File path to Render Secret File (e.g. /etc/secrets/service-account.json)
# FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase-service-account.json

# Comma-separated browser origins allowed to call the backend.
# In production, set this to your deployed Vercel frontend URL(s).
CORS_ALLOWED_ORIGINS=https://link-shortener-mauve-pi.vercel.app,http://localhost:5173

ENV=development

# Redis URL for caching and rate-limit coordination.
# REDIS_URL=redis://localhost:6379/0
