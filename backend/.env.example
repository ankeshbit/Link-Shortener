# Neon PostgreSQL connection URL (backend-only; never expose to the frontend)
DATABASE_URL=postgresql://USER:PASSWORD@EP-example-pooler.us-east-2.aws.neon.tech/DATABASE?sslmode=require

# Canonical public URL encoded in generated short links and QR codes.
# Use the deployed HTTPS backend URL in production.
PUBLIC_BASE_URL=http://localhost:8000

# JWT_SECRET must be configured in the backend environment.
JWT_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated browser origins allowed to call the backend.
# In production, set this to the deployed frontend URL(s).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENV=development

# Optional: Redis improves caching and rate-limit coordination.
# The application remains functional without it.
# REDIS_URL=redis://localhost:6379/0
